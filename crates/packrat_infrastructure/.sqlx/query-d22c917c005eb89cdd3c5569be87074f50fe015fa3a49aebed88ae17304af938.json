{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT t.id, t.name, t.created, t.updated\n            FROM tenants t\n            WHERE t.id IN (\n                SELECT DISTINCT ur.tenant_id\n                FROM user_roles ur\n                WHERE ur.user_id = $1\n            )\n            ORDER BY LOWER(t.name) ASC\n            ",
