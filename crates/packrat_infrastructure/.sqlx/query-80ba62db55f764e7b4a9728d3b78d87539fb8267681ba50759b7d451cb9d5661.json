  "query": "SELECT at.asset_id, t.id as \"tag_id!\", t.tenant_id, t.name\n               FROM asset_tags at\n               INNER JOIN tags t ON t.id = at.tag_id\n               WHERE at.asset_id = ANY($1) AND t.tenant_id = $2\n               ORDER BY at.asset_id ASC, lower(t.name) ASC",
